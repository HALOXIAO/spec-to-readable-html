{
  "version": "diagram-policy/v1",
  "defaults": {
    "render_target": "inline_svg",
    "semantic_source": "flow_ir",
    "show_source_in_appendix": true
  },
  "limits": {
    "max_nodes_per_diagram": 25,
    "max_edges_per_diagram": 40,
    "max_decision_branches": 7
  },
  "required_fields": [
    "purpose",
    "scope",
    "source_refs",
    "reviewer_should_check"
  ],
  "routing": {
    "flowchart": "mermaid",
    "sequence": "mermaid",
    "state": "mermaid",
    "er": "mermaid",
    "architecture": "mermaid",
    "dependency_graph": "mermaid",
    "large_directed_graph": "graphviz_dot",
    "uml_activity": "plantuml"
  },
  "safety": {
    "forbid_agent_authored_svg": true,
    "sanitize_rendered_svg": true,
    "forbid_runtime_cdn_in_review_mode": true,
    "forbidden_svg_patterns": [
      "<script",
      "<foreignObject",
      "javascript:",
      "on[a-zA-Z]+\\s*=",
      "xlink:href\\s*=\\s*[\"']https?://",
      "href\\s*=\\s*[\"']https?://"
    ]
  }
}
