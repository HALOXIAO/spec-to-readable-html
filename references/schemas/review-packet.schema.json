{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/spec-to-readable-html/review-packet.schema.json",
  "title": "ReviewPacket",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "scope", "summary", "automated_checks", "risk_summary", "evidence_matrix", "open_questions", "assumptions", "role_views", "checklist"],
  "properties": {
    "version": { "const": "review-packet/v1" },
    "title": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_files": { "type": "array", "items": { "type": "string" } },
        "source_hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "hash", "lines"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "hash": { "type": "string", "minLength": 1 },
              "lines": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "flow_ir": { "type": "string" },
        "flow_ir_hash": { "type": "string" },
        "review_packet_hash": { "type": "string" },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "what_changed", "why_changed", "impact", "reviewer_should_check"],
      "properties": {
        "intent": { "type": "string" },
        "what_changed": { "type": "array", "items": { "type": "string" } },
        "why_changed": { "type": "array", "items": { "type": "string" } },
        "impact": { "type": "array", "items": { "type": "string" } },
        "reviewer_should_check": { "type": "array", "items": { "type": "string" } }
      }
    },
    "risk_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "reasons"],
      "properties": {
        "overall": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "automated_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "warnings", "blockers"],
      "properties": {
        "passed": { "type": "array", "items": { "$ref": "#/$defs/checkResult" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/checkResult" } },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/checkResult" } }
      }
    },
    "semantic_diff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes_added": { "type": "array" },
        "nodes_removed": { "type": "array" },
        "nodes_changed": { "type": "array" },
        "edges_added": { "type": "array" },
        "edges_removed": { "type": "array" },
        "edges_changed": { "type": "array" },
        "decisions_changed": { "type": "array" },
        "states_changed": { "type": "array" },
        "apis_changed": { "type": "array" },
        "risks_changed": { "type": "array" }
      }
    },
    "evidence_matrix": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRow" }
    },
    "open_questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assumption" }
    },
    "role_views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "engineering", "qa", "security_sre"],
      "properties": {
        "product": { "type": "array", "items": { "type": "string" } },
        "engineering": { "type": "array", "items": { "type": "string" } },
        "qa": { "type": "array", "items": { "type": "string" } },
        "security_sre": { "type": "array", "items": { "type": "string" } }
      }
    },
    "checklist": {
      "type": "array",
      "items": { "$ref": "#/$defs/checklistItem" }
    }
  },
  "$defs": {
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "message"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["passed", "warning", "blocker"] },
        "details": { "type": "string" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "lines": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": { "type": "integer", "minimum": 1 },
            "end": { "type": "integer", "minimum": 1 }
          }
        },
        "quote": { "type": "string" }
      }
    },
    "evidenceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact", "claim", "evidence_type", "confidence", "reviewer_action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "evidence_type": { "type": "string", "enum": ["explicit", "inferred", "assumption", "unsupported", "open_question"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewer_action": { "type": "string" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" },
        "owner": { "type": "string" },
        "action": { "type": "string" },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "rationale"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "checklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "item"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["product", "engineering", "qa", "security_sre", "all"] },
        "item": { "type": "string", "minLength": 1 },
        "owner": { "type": "string" },
        "action": { "type": "string" },
        "blocking": { "type": "boolean" }
      }
    }
  }
}
